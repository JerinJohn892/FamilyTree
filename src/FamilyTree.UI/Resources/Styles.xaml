<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <SolidColorBrush x:Key="Ink" Color="#243B35" />
    <SolidColorBrush x:Key="Muted" Color="#52665E" />
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="#F5F6F2" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="#E7EEE8" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="#BCCDC2" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#245D49" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="#BCCDC2" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Padding" Value="0,0,0,5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#DDE5DD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="BorderBrush" Value="#DDE5DD" />
        <Setter Property="Background" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F5F8F4" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>
</ResourceDictionary>
