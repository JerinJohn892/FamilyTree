<Window x:Class="FamilyTree.UI.Views.FamilyTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FamilyTree · Family tree" Width="1200" Height="800" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh tree" Command="{Binding RefreshCommand}" />
                <TextBlock Text="Your family tree" FontSize="28" FontWeight="SemiBold" Margin="0,0,20,10" />
            </DockPanel>
            <TextBlock Text="Blue · Male    Pink · Female    ↓ Parent to child" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A3023" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFCFA">
            <Grid Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Branches}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Path Data="{Binding Path}" Stroke="#647A76" StrokeThickness="1.8" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Card.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Card.Y}" />
                    </Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#AABDB7" BorderThickness="1" CornerRadius="6" Width="{Binding Card.Width}" Height="{Binding Card.Height}" Background="White" Padding="2">
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{Binding Color}" CornerRadius="4" Padding="12,10" Margin="1,0" ToolTip="{Binding Member.Name}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Member.Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#536765" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
